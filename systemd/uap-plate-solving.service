[Unit]
Description=Moon Cheese offline plate solving (does not use the camera)

[Service]
Type=oneshot
User=uapdetector
Group=uapdetector
WorkingDirectory=/opt/uap-detector/uap
ExecStart=/usr/bin/python3 /opt/uap-detector/uap/plate_solving_worker.py
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uap-detector
TimeoutStartSec=300
