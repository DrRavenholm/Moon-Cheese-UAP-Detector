[Unit]
Description=Moon Cheese replacement Cloudflare Tunnel (temporary verification)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/uap-detector/cloudflared-candidate.token
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/uap-detector/cloudflared-candidate.token

[Install]
WantedBy=multi-user.target
